  "dashboard": {
    "annotations": {
      "list": []
    },
    "description": "Single-worker local demo. ASGI duration is not client delivery latency. Process memory is not pod/node memory. No SLO or alert policy is implied.",
    "editable": false,
    "id": 3580832426614784,
    "panels": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "finsecure-prometheus"
        },
        "description": "Reset-aware counter rate over 2 minutes, summed across bounded routes/methods. Metrics scrapes are excluded by the application.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "fixedColor": "blue",
              "mode": "fixed"
            },
            "decimals": 3,
            "noValue": "No data",
            "unit": "reqps"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "id": 1,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": [
              "last"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "sum(rate(finsecure_http_requests_total{job=\"finsecure-pay\"}[2m]))",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Request rate",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "finsecure-prometheus"
        },
        "description": "Rate of duration sum / rate of observation count over 2 minutes. Idle windows can be undefined; no zero or stale last-non-null substitution. Not an end-to-end latency SLO.",
        "fieldConfig": {
          "defaults": {
            "color": {
              "fixedColor": "blue",
              "mode": "fixed"
            },
            "decimals": 3,
            "noValue": "No active requests",
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {
          "h": 6,
          "w": 8,
          "x": 8,
          "y": 0
        },
        "id": 2,
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "reduceOptions": {
            "calcs": [
              "last"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        },
        "targets": [
          {
            "expr": "sum(rate(finsecure_http_request_duration_seconds_sum{job=\"finsecure-pay\"}[2m])) / sum(rate(finsecure_http_request_duration_seconds_count{job=\"finsecure-pay\"}[2m]))",
            "instant": true,
            "range": false,
            "refId": "A"
          }
        ],
        "title": "Mean ASGI handling latency",
        "type": "stat"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "finsecure-prometheus"
        },
        "description": "Prometheus target health, not business success, application readiness or Kubernetes readiness. Missing series must not appear healthy.",
